{
  "name": "umpoint-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friends and open tenders for UMPoint Badminton. Holds no UMPoint session and books nothing.",
  "scripts": {
    "dev": "wrangler dev --local --var DEV_LOGIN:1",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
}
